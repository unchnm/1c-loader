{
  "name": "onec-loader",
  "displayName": "1C: Loader",
  "description": "Частичная загрузка изменённых XML/BSL-файлов в базу 1С из боковой панели",
  "version": "0.3.0",
  "icon": "media/icon.png",
  "publisher": "unchnm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:onecLoader.panel",
    "onCommand:onecLoader.show",
    "onCommand:onecLoader.refresh",
    "onCommand:onecLoader.enableOnlyUncommitted",
    "onCommand:onecLoader.disableOnlyUncommitted"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onec-loader",
          "title": "1C",
          "icon": "$(onec-loader-logo)"
        }
      ]
    },
    "views": {
      "onec-loader": [
        {
          "type": "webview",
          "id": "onecLoader.panel",
          "name": "Loader"
        }
      ]
    },
    "commands": [
      {
        "command": "onecLoader.show",
        "title": "Открыть загрузку изменений",
        "category": "1C"
      },
      {
        "command": "onecLoader.refresh",
        "title": "Обновить",
        "category": "1C",
        "icon": "$(refresh)"
      },
      {
        "command": "onecLoader.enableOnlyUncommitted",
        "title": "$(check) Показывать только незакоммиченные изменения",
        "category": "1C"
      },
      {
        "command": "onecLoader.disableOnlyUncommitted",
        "title": "Показывать только незакоммиченные изменения",
        "category": "1C"
      }
    ],
    "submenus": [
      {
        "id": "onecLoader.settingsMenu",
        "label": "Настройки списка изменений",
        "icon": "$(kebab-vertical)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onecLoader.refresh",
          "when": "view == onecLoader.panel",
          "group": "navigation"
        },
        {
          "submenu": "onecLoader.settingsMenu",
          "when": "view == onecLoader.panel",
          "group": "navigation"
        }
      ],
      "onecLoader.settingsMenu": [
        {
          "command": "onecLoader.enableOnlyUncommitted",
          "when": "view == onecLoader.panel && onecLoader.onlyUncommitted",
          "group": "navigation"
        },
        {
          "command": "onecLoader.disableOnlyUncommitted",
          "when": "view == onecLoader.panel && !onecLoader.onlyUncommitted",
          "group": "navigation"
        }
      ]
    },
    "icons": {
      "onec-loader-logo": {
        "description": "1C Loader logo",
        "default": {
          "fontPath": "media/onec-loader-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && node --test out/logic.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.0"
  }
}
