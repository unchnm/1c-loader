{
  "name": "onec-loader",
  "displayName": "1C: Загрузка изменений",
    "description": "Частичная загрузка изменённых XML/BSL-файлов в базу 1С из боковой панели",
    "version": "0.2.0",
  "publisher": "unchnm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:onecLoader.panel",
    "onCommand:onecLoader.show"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onec-loader",
          "title": "1C: Загрузка",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "onec-loader": [
        {
          "type": "webview",
          "id": "onecLoader.panel",
          "name": "Загрузка изменений"
        }
      ]
    },
    "commands": [
      {
        "command": "onecLoader.show",
        "title": "Открыть загрузку изменений",
        "category": "1C"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && node --test out/logic.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.0"
  }
}
